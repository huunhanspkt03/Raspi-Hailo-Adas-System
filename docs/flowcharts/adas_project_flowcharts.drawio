ometry x="705" y="515" width="200" height="110" as="geometry"/></mxCell><mxCell id="g-follow" value="Chọn FOLLOW" style="shape=mxgraph.flowchart.data;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="530" width="300" height="85" as="geometry"/></mxCell><mxCell id="g-go" value="Chọn GO" style="shape=mxgraph.flowchart.data;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="530" width="300" height="85" as="geometry"/></mxCell><mxCell id="g-speed" value="Có biển tốc độ?" style="shape=mxgraph.flowchart.decision;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="705" y="700" width="200" height="110" as="geometry"/></mxCell><mxCell id="g-cap" value="Giới hạn tốc độ" style="shape=mxgraph.flowchart.process;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="720" width="300" height="85" as="geometry"/></mxCell><mxCell id="g-raw" value="Tạo trạng thái hành vi" style="shape=mxgraph.flowchart.predefined_process;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=10;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="885" width="370" height="90" as="geometry"/></mxCell><mxCell id="g-smooth" value="Làm mượt theo thời gian" style="shape=mxgraph.flowchart.predefined_process;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontColor=#000000;align=center;verticalAlign=middle;spacing=1