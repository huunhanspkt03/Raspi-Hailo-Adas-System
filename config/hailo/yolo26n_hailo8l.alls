# YOLO26n -> Hailo-8L model script.
# Pattern adapted from hailo_model_zoo cfg/alls/generic/yolov8n.alls.
# YOLO26 is NMS-free (one2one head) so we keep the raw 6-tensor output
# and decode in Python (see src/features/yolo26_raw_head.py).

# Normalize uint8 RGB input to 0..1 inside the model graph.
normalization1 = normalization([0.0, 0.0, 0.0], [255.0, 255.0, 255.0])

# Hailo-8L has fewer compute/memory resources than Hailo-8.
performance_param(compiler_optimization_level=max)
model_optimization_flavor(optimization_level=2)

# Use up to 1024 calibration samples when available.
model_optimization_config(calibration, calibset_size=1024)

# Clip extreme activation/weight tails before quantization.
pre_quantization_optimization(activation_clipping, layers={*}, mode=percentile, clipping_values=[0.01, 99.99])
pre_quantization_optimization(weights_clipping, layers={*}, mode=percentile, clipping_values=[0.01, 99.99])

# Skip QAT fine-tuning to avoid OOM on low-memory systems (WSL/16GB).
# Re-enable on a 32GB+ host for best quantized mAP:
#   post_quantization_optimization(finetune, policy=enabled, learning_rate=0.000025, epochs=4, batch_size=2)
post_quantization_optimization(finetune, policy=disabled)

# Allocator hint from Hailo Model Zoo yolov8* reference.
# Note: spatial_defuse_legacy was removed in DFC 3.33+, keep only width_splitter_defuse.
allocator_param(width_splitter_defuse=disabled)

# --- OPTIONAL: absorb sigmoid of the cls heads into the HEF ---------------
# Hailo's yolov8n reference does:
#   change_output_activation(conv42, sigmoid)  # cls stride  8
#   change_output_activation(conv53, sigmoid)  # cls stride 16
#   change_output_activation(conv63, sigmoid)  # cls stride 32
# To replicate for YOLO26 one2one heads:
#   1) Run `hailo parser onnx ...` (step [1/4] in compile_hailo_yolo.sh).
#   2) Inspect the HAR with `hailo har info outputs/hailo_build/yolo26/parsed/yolo26_adas.har`
#      to discover the conv names that correspond to the 3 end nodes
#      /model.23/one2one_cv3.{0,1,2}/one2one_cv3.{0,1,2}.2/Conv
#   3) Uncomment the three lines below and replace with the real layer names.
#   4) Runtime: export YOLO26_HAILO_SIGMOID_ABSORBED=1 (see yolo26_raw_head.py).
# change_output_activation(<cls_conv_stride8>, sigmoid)
# change_output_activation(<cls_conv_stride16>, sigmoid)
# change_output_activation(<cls_conv_stride32>, sigmoid)
